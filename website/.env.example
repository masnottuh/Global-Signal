# Global Signal - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Data Source Endpoints
# Configure these to point to your live data feeds
# The server will ping these endpoints periodically to fetch data

# Primary market data (prices, OHLCV data)
MARKET_DATA_ENDPOINT=

# Economic indicators (GDP, CPI, employment data, etc.)
ECONOMIC_INDICATORS_ENDPOINT=

# Alternative data sources (satellite, shipping, etc.)
ALTERNATIVE_DATA_ENDPOINT=

# Social sentiment data (aggregated sentiment scores)
SOCIAL_SENTIMENT_ENDPOINT=

# Database Configuration (optional)
# Leave empty to use in-memory storage
# Set to a file path for persistent SQLite storage
# DATABASE_PATH=./signals.db

# Email Configuration (for contact form)
# Integrate with your email service provider
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=info@globalsignal.com
